rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Global Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidCode(code) {
      return code is string && code.size() >= 6 && code.size() <= 12 && code.matches('^[A-Z0-9]+$');
    }

    function isValidTemplateId(id) {
      return id is string && id.size() >= 6 && id.size() <= 24 && id.matches('^[A-Z0-9]+$');
    }

    function schoolData(schoolId) {
      return get(/databases/$(database)/documents/schools/$(schoolId)).data;
    }

    function isSchoolMember(schoolId) {
      return isSignedIn() && request.auth.uid in schoolData(schoolId).memberUids;
    }

    function isSchoolAdmin(schoolId) {
      return isSignedIn() && request.auth.uid in schoolData(schoolId).adminUids;
    }

    function hasNoSchool(uid) {
      return !exists(/databases/$(database)/documents/users/$(uid)) ||
             !('activeSchoolId' in get(/databases/$(database)/documents/users/$(uid)).data) ||
             get(/databases/$(database)/documents/users/$(uid)).data.activeSchoolId == '';
    }

    function classAllowedInProfile(mp, cls) {
      return !('allClasses' in mp) ||
             mp.allClasses == true ||
             ('allowedClasses' in mp && mp.allowedClasses is list && cls in mp.allowedClasses);
    }

    function canManageInProfile(mp) {
      return !('canManageStudents' in mp) || mp.canManageStudents == true;
    }

    function canAttendanceInProfile(mp) {
      return !('canEditAttendance' in mp) || mp.canEditAttendance == true;
    }

    function allSubjectsInProfile(mp) {
      return !('allSubjects' in mp) || mp.allSubjects == true;
    }

    function allowedSubjectsInProfile(mp) {
      return ('allowedSubjects' in mp && mp.allowedSubjects is list)
        ? mp.allowedSubjects
        : [];
    }

    function subjectMarkKeys(sub) {
      return sub == 'ART'
        ? [
            'ART_1_TB', 'ART_1_ACT', 'ART_1_LANG', 'ART_1_CT', 'ART_1_CONT', 'ART_1_TOTAL',
            'ART_2_TB', 'ART_2_ACT', 'ART_2_LANG', 'ART_2_CT', 'ART_2_CONT', 'ART_2_TOTAL',
            'ART_3_TB', 'ART_3_ACT', 'ART_3_LANG', 'ART_3_CT', 'ART_3_CONT', 'ART_3_TOTAL'
          ]
        : [
            sub + '_1_TB', sub + '_1_ACT', sub + '_1_LANG', sub + '_1_CT', sub + '_1_CONT', sub + '_1_WR',
            sub + '_2_TB', sub + '_2_ACT', sub + '_2_LANG', sub + '_2_CT', sub + '_2_CONT', sub + '_2_WR',
            sub + '_3_TB', sub + '_3_ACT', sub + '_3_LANG', sub + '_3_CT', sub + '_3_CONT', sub + '_3_WR'
          ];
    }

    function allowedSubjectKeysFor(allowedSubs) {
      return ('BAN' in allowedSubs ? subjectMarkKeys('BAN') : [])
        .concat('ENG' in allowedSubs ? subjectMarkKeys('ENG') : [])
        .concat('MATH' in allowedSubs ? subjectMarkKeys('MATH') : [])
        .concat('SOC' in allowedSubs ? subjectMarkKeys('SOC') : [])
        .concat('SCI' in allowedSubs ? subjectMarkKeys('SCI') : [])
        .concat('BGW' in allowedSubs ? subjectMarkKeys('BGW') : [])
        .concat('REL' in allowedSubs ? subjectMarkKeys('REL') : [])
        .concat('PE' in allowedSubs ? subjectMarkKeys('PE') : [])
        .concat('ART' in allowedSubs ? subjectMarkKeys('ART') : []);
    }

    function attendanceXKeys() {
      return [
        'DAYS_1', 'DAYS_2', 'DAYS_3',
        'PRES_1', 'PRES_2', 'PRES_3',
        'ACT_1', 'ACT_2', 'ACT_3',
        'DISC_1', 'DISC_2', 'DISC_3',
        'COND_1', 'COND_2', 'COND_3',
        'REM_1', 'REM_2', 'REM_3'
      ];
    }

    function canTeacherCreateWithProfile(mp, newDoc) {
      return canManageInProfile(mp) &&
             classAllowedInProfile(mp, newDoc.cls) &&
             (allSubjectsInProfile(mp) || newDoc.m.keys().hasOnly(allowedSubjectKeysFor(allowedSubjectsInProfile(mp)))) &&
             (canAttendanceInProfile(mp) || !newDoc.x.keys().hasAny(attendanceXKeys()));
    }

    function canCreateStudentDoc(s, newDoc) {
      return isSignedIn() &&
             (request.auth.uid in s.memberUids) &&
             (
               (request.auth.uid in s.adminUids) ||
               !(request.auth.uid in s.memberProfiles) ||
               canTeacherCreateWithProfile(s.memberProfiles[request.auth.uid], newDoc)
             );
    }

    function canTeacherUpdateMarks(mp, newM, oldM) {
      return newM == oldM ||
             allSubjectsInProfile(mp) ||
             newM.diff(oldM).affectedKeys().hasOnly(allowedSubjectKeysFor(allowedSubjectsInProfile(mp)));
    }

    function canTeacherUpdateX(mp, newX, oldX) {
      return newX == oldX ||
             (canAttendanceInProfile(mp) && canManageInProfile(mp)) ||
             (canAttendanceInProfile(mp) && newX.diff(oldX).affectedKeys().hasOnly(attendanceXKeys())) ||
             (canManageInProfile(mp) && !newX.diff(oldX).affectedKeys().hasAny(attendanceXKeys()));
    }

    function canTeacherUpdateWithProfile(mp, newDoc, oldDoc) {
      return classAllowedInProfile(mp, oldDoc.cls) &&
             classAllowedInProfile(mp, newDoc.cls) &&
             (
               canManageInProfile(mp) ||
               !newDoc.diff(oldDoc).affectedKeys().hasAny([
                 'cls', 'roll', 'name', 'guardian', 'village', 'post', 'upazila', 'district', 'mobile', 'religion'
               ])
             ) &&
             canTeacherUpdateMarks(mp, newDoc.m, oldDoc.m) &&
             canTeacherUpdateX(mp, newDoc.x, oldDoc.x);
    }

    function canUpdateStudentDoc(s, newDoc, oldDoc) {
      return isSignedIn() &&
             (request.auth.uid in s.memberUids) &&
             (
               (request.auth.uid in s.adminUids) ||
               !(request.auth.uid in s.memberProfiles) ||
               canTeacherUpdateWithProfile(s.memberProfiles[request.auth.uid], newDoc, oldDoc)
             );
    }

    function canDeleteStudentDoc(s, oldDoc) {
      return isSignedIn() &&
             (request.auth.uid in s.memberUids) &&
             (
               (request.auth.uid in s.adminUids) ||
               !(request.auth.uid in s.memberProfiles) ||
               (
                 canManageInProfile(s.memberProfiles[request.auth.uid]) &&
                 classAllowedInProfile(s.memberProfiles[request.auth.uid], oldDoc.cls)
               )
             );
    }

    // 3. Entity Validation Blueprints
    function isValidUserProfile(data) {
      return data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 &&
             data.displayName is string && data.displayName.size() <= 100 &&
             data.email is string && data.email.size() <= 150 &&
             (!('activeSchoolId' in data) || (data.activeSchoolId is string && data.activeSchoolId.size() <= 128)) &&
             (!('pendingSchoolId' in data) || (data.pendingSchoolId is string && data.pendingSchoolId.size() <= 128)) &&
             (!('pendingSchoolName' in data) || (data.pendingSchoolName is string && data.pendingSchoolName.size() <= 160)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidSchoolCode(data) {
      return isValidId(data.schoolId) &&
             data.schoolName is string && data.schoolName.size() >= 1 && data.schoolName.size() <= 160 &&
             data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
             data.adminUids is list && data.adminUids.size() >= 1 && data.adminUids.size() <= 20 &&
             (data.adminUids.size() == 0 || data.adminUids[0] is string) &&
             data.approvalRequired is bool &&
             data.active is bool &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidSchool(data) {
      return data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
             isValidCode(data.joinCode) &&
             data.approvalRequired is bool &&
             data.memberUids is list && data.memberUids.size() >= 1 && data.memberUids.size() <= 50 &&
             (data.memberUids.size() == 0 || data.memberUids[0] is string) &&
             data.adminUids is list && data.adminUids.size() >= 1 && data.adminUids.size() <= 20 &&
             (data.adminUids.size() == 0 || data.adminUids[0] is string) &&
             data.memberProfiles is map && data.memberProfiles.size() >= 1 && data.memberProfiles.size() <= 50 &&
             data.school is string && data.school.size() >= 1 && data.school.size() <= 160 &&
             data.schoolAddress is string && data.schoolAddress.size() <= 240 &&
             data.year is string && data.year.size() >= 1 && data.year.size() <= 40 &&
             data.teachers is map && data.teachers.size() <= 25 &&
             data.teacherMobiles is map && data.teacherMobiles.size() <= 25 &&
             data.pdfFont is string && data.pdfFont.size() >= 1 && data.pdfFont.size() <= 40 &&
             data.dpeLogo in ['simple', 'color'] &&
             data.customFields is list && data.customFields.size() <= 30 &&
             (data.customFields.size() == 0 || data.customFields[0] is map) &&
             (!('customClasses' in data) || (data.customClasses is list && data.customClasses.size() <= 15 && (data.customClasses.size() == 0 || data.customClasses[0] is map))) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidJoinRequest(data) {
      return data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 &&
             data.displayName is string && data.displayName.size() <= 100 &&
             data.email is string && data.email.size() <= 150 &&
             isValidId(data.schoolId) &&
             data.schoolName is string && data.schoolName.size() >= 1 && data.schoolName.size() <= 160 &&
             data.schoolAdminUids is list && data.schoolAdminUids.size() >= 1 && data.schoolAdminUids.size() <= 20 &&
             (data.schoolAdminUids.size() == 0 || data.schoolAdminUids[0] is string) &&
             data.status == 'PENDING' &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidStudent(data) {
      return data.cls is int && data.cls >= 1 && data.cls <= 20 &&
             data.roll is int && data.roll >= 1 && data.roll <= 9999 &&
             data.name is string && data.name.size() <= 120 &&
             data.guardian is string && data.guardian.size() <= 120 &&
             data.village is string && data.village.size() <= 120 &&
             data.post is string && data.post.size() <= 120 &&
             data.upazila is string && data.upazila.size() <= 120 &&
             data.district is string && data.district.size() <= 120 &&
             data.mobile is string && data.mobile.size() <= 30 &&
             data.religion is string && data.religion.size() >= 1 && data.religion.size() <= 40 &&
             data.m is map && data.m.size() <= 200 &&
             data.x is map && data.x.size() <= 120 &&
             data.updatedByUid is string && data.updatedByUid.size() >= 1 && data.updatedByUid.size() <= 128 &&
             data.updatedByName is string && data.updatedByName.size() <= 100 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidSheetTemplate(data) {
      return isValidTemplateId(data.templateId) &&
             data.cls is int && data.cls >= 1 && data.cls <= 20 &&
             data.subjectKey is string && data.subjectKey.size() <= 24 &&
             data.term is int && data.term >= -1 && data.term <= 3 &&
             data.sheetKind in ['SINGLE_TERM_MARKS', 'THREE_TERM_MARKS', 'ATTENDANCE_TRAITS'] &&
             data.importScope in ['AUTO', 'BOTH', 'CONT_ONLY', 'WR_ONLY'] &&
             data.columnIds is list && data.columnIds.size() >= 1 && data.columnIds.size() <= 30 &&
             (data.columnIds.size() == 0 || data.columnIds[0] is string) &&
             data.customColumnTitles is list && data.customColumnTitles.size() <= 15 &&
             (data.customColumnTitles.size() == 0 || data.customColumnTitles[0] is string) &&
             data.numeralStyle in ['BENGALI', 'ENGLISH'] &&
             data.showSubjectMaxInHeader is bool &&
             data.workingDaysByTerm is map && data.workingDaysByTerm.size() <= 3 &&
             data.pageIndex is int && data.pageIndex >= 1 && data.pageIndex <= 100 &&
             data.totalPages is int && data.totalPages >= 1 && data.totalPages <= 100 &&
             data.refCode is string && data.refCode.size() <= 64 &&
             data.createdByUid is string && data.createdByUid.size() >= 1 && data.createdByUid.size() <= 128 &&
             data.updatedByUid is string && data.updatedByUid.size() >= 1 && data.updatedByUid.size() <= 128 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    // 4. Users Collection (PII strictly isolated to owner)
    match /users/{userId} {
      allow get, list: if isSignedIn() && request.auth.uid == userId;

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().uid == request.auth.uid &&
                       incoming().keys().hasAll(['uid', 'displayName', 'email', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['uid', 'displayName', 'email', 'activeSchoolId', 'pendingSchoolId', 'pendingSchoolName', 'createdAt', 'updatedAt']) &&
                       isValidUserProfile(incoming());

      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       isValidUserProfile(incoming()) &&
                       incoming().uid == existing().uid &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'activeSchoolId', 'pendingSchoolId', 'pendingSchoolName', 'updatedAt']);

      allow delete: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
    }

    // 5. School Invite Code Lookup (get by exact code only; list forbidden)
    match /schoolCodes/{code} {
      allow get: if isSignedIn() && isValidCode(code);
      allow list: if false;

      allow create: if isSignedIn() &&
                       isValidCode(code) &&
                       incoming().ownerUid == request.auth.uid &&
                       request.auth.uid in incoming().adminUids &&
                       incoming().approvalRequired == true &&
                       incoming().keys().hasAll(['schoolId', 'schoolName', 'ownerUid', 'adminUids', 'approvalRequired', 'active', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['schoolId', 'schoolName', 'ownerUid', 'adminUids', 'approvalRequired', 'active', 'createdAt', 'updatedAt']) &&
                       isValidSchoolCode(incoming()) &&
                       existsAfter(/databases/$(database)/documents/schools/$(incoming().schoolId));

      allow update: if isSignedIn() &&
                       isValidCode(code) &&
                       isValidSchoolCode(incoming()) &&
                       request.auth.uid in existing().adminUids &&
                       incoming().schoolId == existing().schoolId &&
                       incoming().ownerUid == existing().ownerUid &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['schoolName', 'adminUids', 'approvalRequired', 'active', 'updatedAt']);

      allow delete: if isSignedIn() &&
                       isValidCode(code) &&
                       (request.auth.uid == existing().ownerUid || request.auth.uid in existing().adminUids);
    }

    // 6. Collaborative School Workspaces (One school per user + Admin approval required)
    match /schools/{schoolId} {
      allow get: if isSignedIn() &&
                    isValidId(schoolId) &&
                    (request.auth.uid in existing().memberUids || request.auth.uid == existing().ownerUid);

      allow list: if isSignedIn() && request.auth.uid in resource.data.memberUids;

      allow create: if isSignedIn() &&
                       isValidId(schoolId) &&
                       hasNoSchool(request.auth.uid) &&
                       incoming().ownerUid == request.auth.uid &&
                       incoming().approvalRequired == true &&
                       request.auth.uid in incoming().adminUids &&
                       request.auth.uid in incoming().memberUids &&
                       request.auth.uid in incoming().memberProfiles &&
                       incoming().memberProfiles[request.auth.uid].uid == request.auth.uid &&
                       incoming().memberProfiles[request.auth.uid].role == 'ADMIN' &&
                       incoming().keys().hasAll(['ownerUid', 'joinCode', 'approvalRequired', 'memberUids', 'adminUids', 'memberProfiles', 'school', 'schoolAddress', 'year', 'teachers', 'teacherMobiles', 'pdfFont', 'dpeLogo', 'customFields', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['ownerUid', 'joinCode', 'approvalRequired', 'memberUids', 'adminUids', 'memberProfiles', 'school', 'schoolAddress', 'year', 'teachers', 'teacherMobiles', 'pdfFont', 'dpeLogo', 'customFields', 'customClasses', 'createdAt', 'updatedAt']) &&
                       isValidSchool(incoming()) &&
                       existsAfter(/databases/$(database)/documents/schoolCodes/$(incoming().joinCode));

      allow update: if isSignedIn() &&
                       isValidId(schoolId) &&
                       isValidSchool(incoming()) &&
                       incoming().ownerUid == existing().ownerUid &&
                       incoming().createdAt == existing().createdAt && (
                         // Action 1: Admin updates school settings, code, member list, approvals, or teacher permissions
                         (
                           request.auth.uid in existing().adminUids &&
                           existing().ownerUid in incoming().adminUids &&
                           existing().ownerUid in incoming().memberUids &&
                           incoming().diff(existing()).affectedKeys().hasOnly([
                             'joinCode', 'approvalRequired', 'memberUids', 'adminUids', 'memberProfiles',
                             'school', 'schoolAddress', 'year', 'teachers', 'teacherMobiles',
                             'pdfFont', 'dpeLogo', 'customFields', 'customClasses', 'updatedAt'
                           ])
                         ) ||
                         // Action 2: Non-owner member leaves school
                         (
                           request.auth.uid in existing().memberUids &&
                           request.auth.uid != existing().ownerUid &&
                           incoming().diff(existing()).affectedKeys().hasOnly(['memberUids', 'adminUids', 'memberProfiles', 'updatedAt']) &&
                           !(request.auth.uid in incoming().memberUids) &&
                           !(request.auth.uid in incoming().adminUids) &&
                           !(request.auth.uid in incoming().memberProfiles) &&
                           existing().memberUids.hasAll(incoming().memberUids) &&
                           existing().adminUids.hasAll(incoming().adminUids) &&
                           existing().memberProfiles.diff(incoming().memberProfiles).affectedKeys().hasOnly([request.auth.uid]) &&
                           incoming().memberUids.size() == existing().memberUids.size() - 1
                         )
                       );

      allow delete: if isSignedIn() && isValidId(schoolId) && request.auth.uid == existing().ownerUid;

      // 7. Pending Join Requests Subcollection (Always required for joining)
      match /joinRequests/{requestUid} {
        allow get: if isSignedIn() &&
                      isValidId(schoolId) &&
                      isValidId(requestUid) &&
                      (request.auth.uid == requestUid || isSchoolAdmin(schoolId));

        allow list: if isSignedIn() &&
                       (resource.data.uid == request.auth.uid || request.auth.uid in resource.data.schoolAdminUids);

        allow create: if isSignedIn() &&
                         isValidId(schoolId) &&
                         isValidId(requestUid) &&
                         hasNoSchool(request.auth.uid) &&
                         request.auth.uid == requestUid &&
                         incoming().uid == request.auth.uid &&
                         incoming().schoolId == schoolId &&
                         incoming().keys().hasAll(['uid', 'displayName', 'email', 'schoolId', 'schoolName', 'schoolAdminUids', 'status', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['uid', 'displayName', 'email', 'schoolId', 'schoolName', 'schoolAdminUids', 'status', 'createdAt', 'updatedAt']) &&
                         isValidJoinRequest(incoming()) &&
                         exists(/databases/$(database)/documents/schools/$(schoolId)) &&
                         incoming().schoolAdminUids == schoolData(schoolId).adminUids;

        allow update: if false;

        allow delete: if isSignedIn() &&
                         isValidId(schoolId) &&
                         isValidId(requestUid) &&
                         (request.auth.uid == requestUid || isSchoolAdmin(schoolId));
      }

      // 8. School Students Subcollection (Granular teacher permissions enforced on writes)
      match /students/{studentId} {
        allow get: if isValidId(schoolId) && isValidId(studentId) && isSchoolMember(schoolId);
        allow list: if isValidId(schoolId) && isSchoolMember(schoolId);

        allow create: if isValidId(schoolId) &&
                         isValidId(studentId) &&
                         isSignedIn() &&
                         incoming().updatedByUid == request.auth.uid &&
                         incoming().keys().hasAll(['cls', 'roll', 'name', 'guardian', 'village', 'post', 'upazila', 'district', 'mobile', 'religion', 'm', 'x', 'updatedByUid', 'updatedByName', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['cls', 'roll', 'name', 'guardian', 'village', 'post', 'upazila', 'district', 'mobile', 'religion', 'm', 'x', 'updatedByUid', 'updatedByName', 'createdAt', 'updatedAt']) &&
                         isValidStudent(incoming()) &&
                         canCreateStudentDoc(schoolData(schoolId), incoming());

        allow update: if isValidId(schoolId) &&
                         isValidId(studentId) &&
                         isSignedIn() &&
                         isValidStudent(incoming()) &&
                         incoming().updatedByUid == request.auth.uid &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'cls', 'roll', 'name', 'guardian', 'village', 'post', 'upazila', 'district',
                           'mobile', 'religion', 'm', 'x', 'updatedByUid', 'updatedByName', 'updatedAt'
                         ]) &&
                         canUpdateStudentDoc(schoolData(schoolId), incoming(), existing());

        allow delete: if isValidId(schoolId) &&
                         isValidId(studentId) &&
                         isSignedIn() &&
                         canDeleteStudentDoc(schoolData(schoolId), existing());
      }

      // 9. Smart Blank Sheet Templates Subcollection (Thin QR & Offline Pre-cache metadata)
      match /sheetTemplates/{templateId} {
        allow get: if isValidId(schoolId) &&
                      isValidTemplateId(templateId) &&
                      isSchoolMember(schoolId);
        allow list: if isValidId(schoolId) && isSchoolMember(schoolId);

        allow create: if isSignedIn() &&
                         isValidId(schoolId) &&
                         isValidTemplateId(templateId) &&
                         incoming().templateId == templateId &&
                         incoming().createdByUid == request.auth.uid &&
                         incoming().updatedByUid == request.auth.uid &&
                         incoming().keys().hasAll([
                           'templateId', 'cls', 'subjectKey', 'term', 'sheetKind', 'importScope',
                           'columnIds', 'customColumnTitles', 'numeralStyle', 'showSubjectMaxInHeader',
                           'workingDaysByTerm', 'pageIndex', 'totalPages', 'refCode',
                           'createdByUid', 'updatedByUid', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'templateId', 'cls', 'subjectKey', 'term', 'sheetKind', 'importScope',
                           'columnIds', 'customColumnTitles', 'numeralStyle', 'showSubjectMaxInHeader',
                           'workingDaysByTerm', 'pageIndex', 'totalPages', 'refCode',
                           'createdByUid', 'updatedByUid', 'createdAt', 'updatedAt'
                         ]) &&
                         isValidSheetTemplate(incoming()) &&
                         isSchoolMember(schoolId);

        allow update: if isSignedIn() &&
                         isValidId(schoolId) &&
                         isValidTemplateId(templateId) &&
                         isValidSheetTemplate(incoming()) &&
                         incoming().templateId == existing().templateId &&
                         incoming().createdByUid == existing().createdByUid &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().updatedByUid == request.auth.uid &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'cls', 'subjectKey', 'term', 'sheetKind', 'importScope',
                           'columnIds', 'customColumnTitles', 'numeralStyle', 'showSubjectMaxInHeader',
                           'workingDaysByTerm', 'pageIndex', 'totalPages', 'refCode',
                           'updatedByUid', 'updatedAt'
                         ]) &&
                         isSchoolMember(schoolId);

        allow delete: if isValidId(schoolId) &&
                         isValidTemplateId(templateId) &&
                         isSignedIn() &&
                         (
                           isSchoolAdmin(schoolId) ||
                           (isSchoolMember(schoolId) && existing().createdByUid == request.auth.uid)
                         );
      }
    }
  }
}
